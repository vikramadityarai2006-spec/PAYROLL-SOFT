# ---- Payroll Management App environment ----

# SQLite database file (local, never commit the real DB)
DATABASE_URL="file:./dev.db"

# Admin login password (change this!). Used for the single-admin login.
ADMIN_PASSWORD="admin123"

# Secret used to sign the session cookie. Use a long random string in production.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET="please-change-this-to-a-long-random-string-min-32-chars"

# Session lifetime in hours
SESSION_TTL_HOURS="8"
